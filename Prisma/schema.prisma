generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  CONTRATANTE
  PRESTADOR
  AMBOS
}

enum Modo {
  CLIENTE
  PRESTADOR
}

enum TipoCodigo {
  EMAIL_CADASTRO
  RECUPERAR_SENHA
}

enum TipoQuando {
  DIA_CERTO
  ENTRE_DIAS
  QUALQUER_DIA
}

enum StatusPedido {
  ABERTO
  FECHADO
  CANCELADO
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
}

model User {
  id            String    @id @default(uuid())
  nome          String?
  email         String?   @unique
  emailVerified DateTime?
  senha         String?
  telefone      String?   @unique
  image         String?
  role          Role      @default(CONTRATANTE)
  modoAtual     Modo      @default(CLIENTE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  servicosContratados Servico[]           @relation("ClienteServicos")
  servicosOferecidos  Servico[]           @relation("PrestadorServicos")
  propostas           Proposta[]          @relation("PrestadorPropostas")
  pushSubscriptions   PushSubscription[]
  codigos             CodigoVerificacao[]
  perfilPrestador     PerfilPrestador?
  endereco            EnderecoUsuario?
  pedidos             Pedido[]            @relation("PedidosCliente")

  // Chat (Fase 4)
  conversasComoCliente   Conversa[] @relation("ConversaCliente")
  conversasComoPrestador Conversa[] @relation("ConversaPrestador")
  mensagens              Mensagem[]
  contratosComoCliente   Contrato[] @relation("ContratoCliente")
  contratosComoPrestador Contrato[] @relation("ContratoPrestador")
  bloqueiosFeitos        Bloqueio[] @relation("BloqueioAutor")
  bloqueiosRecebidos     Bloqueio[] @relation("BloqueioAlvo")
  denunciasFeitas        Denuncia[] @relation("DenunciaAutor")
  denunciasRecebidas     Denuncia[] @relation("DenunciaAlvo")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Servico {
  id        String @id @default(uuid())
  titulo    String
  descricao String
  preco     Float

  latitude    Float
  longitude   Float
  localizacao Unsupported("geometry(Point, 4326)")?

  // Campos do front novo (Fase 3): anúncio com categoria, fotos e pausa
  categoria String   @default("outros")
  ativo     Boolean  @default(true)
  fotos     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  clienteId String?
  cliente   User?   @relation("ClienteServicos", fields: [clienteId], references: [id])

  prestadorId String
  prestador   User   @relation("PrestadorServicos", fields: [prestadorId], references: [id], onDelete: Cascade)

  propostas Proposta[]
}

model Proposta {
  id        String         @id @default(uuid())
  valor     Float
  mensagem  String?
  status    StatusProposta @default(PENDENTE)
  createdAt DateTime       @default(now())

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  prestadorId String
  prestador   User   @relation("PrestadorPropostas", fields: [prestadorId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      Json
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Códigos de 6 dígitos enviados por email (confirmar cadastro, recuperar senha).
// Guardamos só o hash do código, nunca o número.
model CodigoVerificacao {
  id         String     @id @default(uuid())
  userId     String
  tipo       TipoCodigo
  codigoHash String
  expiraEm   DateTime
  tentativas Int        @default(0)
  usadoEm    DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
}

// Dados de quem faz bicos (criado pelo "Quero fazer bicos")
model PerfilPrestador {
  id            String    @id @default(uuid())
  userId        String    @unique
  categorias    String[]
  bio           String?
  bairro        String
  cidade        String
  latitude      Float
  longitude     Float
  raioKm        Int       @default(10)
  precoBase     Float?
  disponivel    Boolean   @default(false)
  disponivelAte DateTime?
  ultimoSinal   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Endereço que a pessoa salva no perfil (preenche os pedidos e calcula distâncias)
model EnderecoUsuario {
  id          String   @id @default(uuid())
  userId      String   @unique
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  latitude    Float
  longitude   Float
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Pedido publicado pelo cliente (normal ou urgente).
// Prestadores só veem bairro e distância; rua e número ficam para depois de combinar.
model Pedido {
  id          String       @id @default(uuid())
  clienteId   String
  categoria   String
  descricao   String
  fotos       String[]     @default([])
  urgente     Boolean      @default(false)
  urgenteAte  DateTime?
  quandoTipo  TipoQuando
  dataInicio  DateTime?    @db.Date
  dataFim     DateTime?    @db.Date
  horaInicio  String?
  horaFim     String?
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  latitude    Float
  longitude   Float
  status      StatusPedido @default(ABERTO)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  cliente User @relation("PedidosCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  conversas Conversa[]

  @@index([status, categoria])
}

// ---------- Chat (Fase 4) ----------

enum TipoMensagem {
  TEXTO
  PROPOSTA
  SISTEMA
}

enum StatusPropostaChat {
  PENDENTE
  ACEITA
  RECUSADA
  SUBSTITUIDA // trocada por uma nova proposta ("Negociar")
}

enum StatusContrato {
  COMBINADO
  CONCLUIDO
  CANCELADO
}

// Uma conversa por dupla: quem contrata (cliente) e quem trabalha (prestador).
// servicoId/pedidoId guardam de onde veio a conversa mais recente.
model Conversa {
  id               String    @id @default(uuid())
  clienteId        String
  prestadorId      String
  servicoId        String?
  pedidoId         String?
  // Até quando cada lado leu (para "não lidas" e "visto")
  lidaClienteEm    DateTime?
  lidaPrestadorEm  DateTime?
  ultimaMensagemEm DateTime  @default(now())
  createdAt        DateTime  @default(now())

  cliente   User       @relation("ConversaCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  prestador User       @relation("ConversaPrestador", fields: [prestadorId], references: [id], onDelete: Cascade)
  pedido    Pedido?    @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  mensagens Mensagem[]
  contratos Contrato[]

  @@unique([clienteId, prestadorId])
  @@index([prestadorId])
}

model Mensagem {
  id                 String              @id @default(uuid())
  conversaId         String
  autorId            String? // vazio nas mensagens do sistema
  tipo               TipoMensagem        @default(TEXTO)
  texto              String?
  fotoUrl            String?
  // Proposta: valor + quando
  valor              Float?
  quandoTipo         TipoQuando?
  dataInicio         DateTime?           @db.Date
  dataFim            DateTime?           @db.Date
  horaInicio         String?
  horaFim            String?
  pedidoId           String?
  statusProposta     StatusPropostaChat?
  propostaAnteriorId String?
  createdAt          DateTime            @default(now())

  conversa Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor    User?     @relation(fields: [autorId], references: [id], onDelete: SetNull)
  contrato Contrato?

  @@index([conversaId, createdAt])
}

// O "serviço fechado". Pagamento e conclusão chegam na Fase 5.
model Contrato {
  id          String         @id @default(uuid())
  conversaId  String
  propostaId  String         @unique
  clienteId   String
  prestadorId String
  pedidoId    String?
  servicoId   String?
  valor       Float
  quandoTipo  TipoQuando
  dataInicio  DateTime?      @db.Date
  dataFim     DateTime?      @db.Date
  horaInicio  String?
  horaFim     String?
  status      StatusContrato @default(COMBINADO)
  createdAt   DateTime       @default(now())

  conversa  Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  proposta  Mensagem @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  cliente   User     @relation("ContratoCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  prestador User     @relation("ContratoPrestador", fields: [prestadorId], references: [id], onDelete: Cascade)
}

model Bloqueio {
  autorId     String
  bloqueadoId String
  createdAt   DateTime @default(now())

  autor     User @relation("BloqueioAutor", fields: [autorId], references: [id], onDelete: Cascade)
  bloqueado User @relation("BloqueioAlvo", fields: [bloqueadoId], references: [id], onDelete: Cascade)

  @@id([autorId, bloqueadoId])
}

// Denúncias ficam guardadas para a equipe revisar
model Denuncia {
  id           String   @id @default(uuid())
  autorId      String
  denunciadoId String
  conversaId   String?
  motivo       String
  detalhe      String?
  revisada     Boolean  @default(false)
  createdAt    DateTime @default(now())

  autor      User @relation("DenunciaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  denunciado User @relation("DenunciaAlvo", fields: [denunciadoId], references: [id], onDelete: Cascade)
}
